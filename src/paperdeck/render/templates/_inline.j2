{% macro inlines(nodes) -%}
{% for n in nodes -%}
{% if n.type == 'text' %}{{ n.text }}{% elif n.type == 'emph' %}<em>{{ inlines(n.content) }}</em>{% elif n.type == 'strong' %}<strong>{{ inlines(n.content) }}</strong>{% elif n.type == 'sub' %}<sub>{{ inlines(n.content) }}</sub>{% elif n.type == 'sup' %}<sup>{{ inlines(n.content) }}</sup>{% elif n.type == 'code' %}<code>{{ n.text }}</code>{% elif n.type == 'math' %}<span class="pd-math" data-latex="{{ n.latex }}">{{ n.latex }}</span>{% elif n.type == 'ref_link' %}{% if n.target_id %}<a class="pd-ref" href="#{{ n.target_id }}" data-kind="{{ n.kind }}">{{ n.text }}</a>{% else %}<span class="pd-ref-dead" title="unresolved reference">{{ n.text }}</span>{% endif %}{% elif n.type == 'cite' %}{% if n.bib_ids|length == 1 and n.bib_ids[0] %}<a class="pd-ref" data-kind="bib" href="#{{ n.bib_ids[0] }}">{{ n.text }}</a>{% elif n.bib_ids %}[{% for id in n.bib_ids %}{% if id %}<a class="pd-ref" data-kind="bib" href="#{{ id }}">{{ bib_labels.get(id, '?') }}</a>{% else %}<span class="pd-ref-dead">?</span>{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}]{% else %}<span class="pd-ref-dead" title="unresolved citation">{{ n.text }}</span>{% endif %}{% elif n.type == 'ext_link' %}<a href="{{ n.url }}" target="_blank" rel="noopener noreferrer">{{ inlines(n.content) }}</a>{% elif n.type == 'footnote_ref' %}{% if n.target_id %}{% set count = footnote_counts.get(n.target_id, 0) + 1 %}{% set _ = footnote_counts.update({n.target_id: count}) %}<sup><a class="pd-ref" id="pd-fn-link-{{ n.target_id }}{% if count > 1 %}-{{ count }}{% endif %}" data-kind="fn" href="#{{ n.target_id }}">{{ n.number }}</a></sup>{% else %}<sup class="pd-ref-dead">{{ n.number }}</sup>{% endif %}{% elif n.type == 'line_break' %}<br>{% endif %}
{%- endfor %}
{%- endmacro %}
