{% set bib_labels = {} %}{% for entry in doc.bibliography %}{% set _ = bib_labels.update({entry.id: entry.label or entry.number or '?'}) %}{% endfor %}
{% from '_inline.j2' import inlines with context %}
{% from '_block.j2' import blocks, block with context %}
{% macro toc(nodes) %}<ol>{% for n in nodes %}{% if n.type == 'section' %}<li data-level="{{ n.level }}"><a class="pd-ref pd-toc-link" data-kind="sec" href="#{{ n.id }}">{% if n.number %}{{ n.number }} {% endif %}{{ section_titles[n.id] }}</a>{{ toc(n.children) }}</li>{% endif %}{% endfor %}</ol>{% endmacro %}
<!doctype html>
<html lang="en" data-theme="light" data-theme-mode="auto">
<head>{% include '_head.j2' %}</head>
<body>
<header id="pd-header"><span class="pd-brand">paperdeck</span><span class="pd-header-title">{{ title }}</span><div class="pd-controls"><button id="pd-toc-toggle" aria-controls="pd-toc">Contents</button><button id="pd-theme-toggle">Theme: auto</button><button id="pd-help-toggle" aria-label="Keyboard help"><span class="pd-help-wide">Keyboard help</span><span class="pd-help-short">Help</span></button></div></header>
<nav id="pd-toc" aria-label="Table of contents"><h2>Contents</h2>{{ toc(doc.body) }}</nav>
<div id="pd-main-wrap"><main id="pd-content">
<header class="pd-document-header"><h1>{{ inlines(doc.meta.title) }}</h1><p class="pd-authors">{{ doc.meta.authors|join(', ') }}</p>{% if doc.meta.links %}<p class="pd-source-links">{% for link in doc.meta.links %}<a href="{{ link.url }}" rel="noopener noreferrer" target="_blank">{{ link.kind }}</a>{% endfor %}</p>{% endif %}{% if doc.meta.abstract %}<details class="pd-abstract" open><summary>Abstract</summary>{{ blocks(doc.meta.abstract) }}</details>{% endif %}</header>
{{ blocks(doc.body) }}
{% if doc.bibliography %}<section id="pd-references"><h2>References</h2><ol class="pd-bib">{% for entry in doc.bibliography %}<li id="{{ entry.id }}">{% if entry.label %}<strong>{{ entry.label }}.</strong> {% endif %}{{ inlines(entry.content) }}{% for link in entry.urls %} <a href="{{ link.url }}" rel="noopener noreferrer" target="_blank">{{ link.kind }}</a>{% endfor %}</li>{% endfor %}</ol></section>{% endif %}
{% if doc.footnotes %}<section class="pd-footnotes" id="pd-footnotes"><h2>Notes</h2><ol>{% for note in doc.footnotes %}{{ block(note) }}{% endfor %}</ol></section>{% endif %}
<footer class="pd-provenance"><details><summary>Converted with {{ doc.provenance.engine }} · {{ doc.warnings|length + bundle.dropped|length }} warnings</summary><p>{% for name, version in doc.provenance.engine_versions.items() %}{{ name }} {{ version }}{% if not loop.last %} · {% endif %}{% endfor %}</p>{% if doc.provenance.llm %}<p>LLM: {{ doc.provenance.llm.model }} · {% if doc.provenance.llm.cost_usd is none %}cost unavailable{% else %}${{ '%.4f'|format(doc.provenance.llm.cost_usd) }}{% endif %}</p>{% endif %}<ul>{% for warning in doc.warnings %}<li>{{ warning.code }}: {{ warning.message }}</li>{% endfor %}{% for dropped in bundle.dropped %}<li>Image omitted to fit size limit: {{ dropped.id }}</li>{% endfor %}</ul></details></footer>
</main></div>
<script type="application/json" id="pd-data">{{ data_json }}</script>
{% for text in script_texts[1:] %}<script>{{ text }}</script>{% endfor %}
</body></html>
